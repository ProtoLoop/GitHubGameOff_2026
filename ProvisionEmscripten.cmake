# Pinned web compiler bootstrap. No SDK activation or machine-specific SDK paths.
# Archive URLs come from emscripten-core/emsdk tag 5.0.7 and nodejs.org.
set(GAMEOFF_TOOLCHAIN_CACHE "${CMAKE_CURRENT_LIST_DIR}/build/toolchains" CACHE PATH
    "Local archive and extracted toolchain cache")
option(GAMEOFF_TOOLCHAIN_OFFLINE "Require cached toolchain archives, without downloads" OFF)
get_filename_component(GAMEOFF_TOOLCHAIN_CACHE "${GAMEOFF_TOOLCHAIN_CACHE}" ABSOLUTE
    BASE_DIR "${CMAKE_CURRENT_LIST_DIR}")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES
    GAMEOFF_TOOLCHAIN_CACHE GAMEOFF_TOOLCHAIN_OFFLINE)

function(gameoff_extract_tool name url hash destination)
    if(EXISTS "${destination}/.complete")
        return()
    endif()
    set(archive "${GAMEOFF_TOOLCHAIN_CACHE}/archives/${name}")
    if(NOT EXISTS "${archive}")
        if(GAMEOFF_TOOLCHAIN_OFFLINE)
            message(FATAL_ERROR "Offline toolchain archive missing: ${archive}\nObtain it from: ${url}")
        endif()
        message(STATUS "Downloading ${name}")
        file(DOWNLOAD "${url}" "${archive}.part" EXPECTED_HASH "SHA256=${hash}"
            TLS_VERIFY ON STATUS status SHOW_PROGRESS)
        list(GET status 0 code)
        if(NOT code EQUAL 0)
            message(FATAL_ERROR "Toolchain download failed: ${status}")
        endif()
        file(RENAME "${archive}.part" "${archive}")
    endif()
    file(SHA256 "${archive}" actual_hash)
    if(NOT actual_hash STREQUAL hash)
        message(FATAL_ERROR "Toolchain archive checksum mismatch: ${archive}\nExpected SHA256: ${hash}")
    endif()
    message(STATUS "Extracting ${name}")
    file(REMOVE_RECURSE "${destination}.partial")
    file(MAKE_DIRECTORY "${destination}.partial")
    file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${destination}.partial")
    file(WRITE "${destination}.partial/.complete" "${hash}\n")
    file(REMOVE_RECURSE "${destination}")
    file(RENAME "${destination}.partial" "${destination}")
endfunction()

function(gameoff_prepare_toolchain)
    cmake_host_system_information(RESULT host_arch QUERY OS_PLATFORM)
    if(host_arch MATCHES "^(arm64|aarch64|ARM64)$")
        set(arch arm64)
    elseif(host_arch MATCHES "^(x86_64|AMD64|amd64)$")
        set(arch x64)
    else()
        message(FATAL_ERROR "Unsupported web compiler host architecture: ${host_arch}")
    endif()
    set(host "${CMAKE_HOST_SYSTEM_NAME}-${arch}")
    set(revision 6cd98e86d7749ff98b82b7f2ae78eb4f01942788)
    set(em_file wasm-binaries.tar.xz)
    set(node_ext tar.xz)
    set(exe "")
    if(host STREQUAL "Darwin-arm64")
        set(em_os mac)
        set(em_file wasm-binaries-arm64.tar.xz)
        set(em_hash 37554ed4c36abb1c802aa280f2c1ef9702e19e832a66c2fe6d940b65a2049b2c)
        set(node_os darwin)
        set(node_hash aaf7fc3c936f1b359bc312b63638e41f258689ac2303966ad932cda18c54ea00)
    elseif(host STREQUAL "Darwin-x64")
        set(em_os mac)
        set(em_hash 0ccd510ae3e1014ffc565de482982507d1c2d3d6dc6f5bf243e857c73bd5d352)
        set(node_os darwin)
        set(node_hash 5c34638f2c0e3f3aaa7b3a94b58304765a169730da1896ebba8515ea4d987a9c)
    elseif(host STREQUAL "Linux-arm64")
        set(em_os linux)
        set(em_file wasm-binaries-arm64.tar.xz)
        set(em_hash 3cd706f3c97bc9e2abc9898c66ed15988243d189194623a4fb02ec207dc48693)
        set(node_os linux)
        set(node_hash eab80cb88f8fda1e65f5e8d0420c9809bdb320b03fd34976ab7161b6e703b910)
    elseif(host STREQUAL "Linux-x64")
        set(em_os linux)
        set(em_hash f96cc4df9263e386d70ad37c731959886cb2a7e983b7a68bdc9ccf32402be1bd)
        set(node_os linux)
        set(node_hash f4cb75bb036f0d0eddf6b79d9596df1aaab9ddccd6a20bf489be5abe9467e84e)
    elseif(host STREQUAL "Windows-x64")
        set(em_os win)
        set(em_file wasm-binaries.zip)
        set(em_hash 32995a98db21951cb7e84b4898b235ba57553c9f35eeaa158cfff052fab83856)
        set(node_os win)
        set(node_ext zip)
        set(node_hash 21c2d9735c80b8f86dab19305aa6a9f6f59bbc808f68de3eef09d5832e3bfbbd)
        set(exe .exe)
    else()
        message(FATAL_ERROR "Unsupported web compiler host: ${host}")
    endif()

    # Serialize extraction across simultaneous configure/try_compile processes.
    file(MAKE_DIRECTORY "${GAMEOFF_TOOLCHAIN_CACHE}/archives")
    file(LOCK "${GAMEOFF_TOOLCHAIN_CACHE}/setup.lock" GUARD FUNCTION TIMEOUT 600)
    set(install "${GAMEOFF_TOOLCHAIN_CACHE}/${host}/emscripten-5.0.7-node-22.16.0")
    set(em_url "https://storage.googleapis.com/webassembly/emscripten-releases-builds/${em_os}/${revision}/${em_file}")
    if(em_file MATCHES "zip$")
        set(em_ext zip)
    else()
        set(em_ext tar.xz)
    endif()
    gameoff_extract_tool("emscripten-5.0.7-${host}.${em_ext}" "${em_url}" "${em_hash}" "${install}/upstream")
    set(node_name "node-v22.16.0-${node_os}-${arch}")
    gameoff_extract_tool("${node_name}.${node_ext}"
        "https://nodejs.org/dist/v22.16.0/${node_name}.${node_ext}"
        "${node_hash}" "${install}/node")

    set(em_root "${install}/upstream/install/emscripten")
    if(CMAKE_HOST_WIN32)
        set(node_relative "node/${node_name}/node.exe")
    else()
        set(node_relative "node/${node_name}/bin/node")
    endif()
    set(node "${install}/${node_relative}")
    if(NOT EXISTS "${em_root}/emcc.py" OR NOT EXISTS "${node}")
        message(FATAL_ERROR "Unexpected archive layout in ${install}")
    endif()

    # Relative paths let the extracted cache be moved before a fresh configure.
    set(config "import os\n")
    string(APPEND config "_root = os.path.dirname(os.path.abspath(__file__))\n")
    string(APPEND config "LLVM_ROOT = os.path.normpath(os.path.join(_root, '..', 'bin'))\n")
    string(APPEND config "BINARYEN_ROOT = os.path.normpath(os.path.join(_root, '..'))\n")
    string(APPEND config "NODE_JS = [os.path.normpath(os.path.join(_root, '..', '..', '..', '${node_relative}'))]\n")
    string(APPEND config "CACHE = os.path.join(_root, 'cache')\n")
    file(CONFIGURE OUTPUT "${em_root}/.emscripten" CONTENT "${config}" @ONLY)
    set(GAMEOFF_EM_ROOT "${em_root}" PARENT_SCOPE)
    set(GAMEOFF_NODE "${node}" PARENT_SCOPE)
    set(GAMEOFF_EXE_SUFFIX "${exe}" PARENT_SCOPE)
endfunction()

