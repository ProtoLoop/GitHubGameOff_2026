CompileFlags:
  CompilationDatabase: build

Index:
  Background: Build

Completion:
  HeaderInsertion: IWYU

Diagnostics:
  ClangTidy:
    FastCheckFilter: None

---

If:
  PathExclude: src/.*  # Inside the If block

Diagnostics:           # Outside the If block
  Suppress: '*'
  ClangTidy:
    Remove: '*'
