{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Game (LLDB, macOS)",
            "type": "lldb",
            "request": "launch",
            "expressions": "native",
            "program": "${command:cmake.launchTargetPath}",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Game (Browser)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:8000/build/web/${command:cmake.buildType}/index.html",
            "webRoot": "${workspaceFolder}"
        }
    ]
}
