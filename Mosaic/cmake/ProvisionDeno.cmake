set(MOSAIC_DENO_CACHE "${CMAKE_CURRENT_BINARY_DIR}/toolchains" CACHE PATH
    "Cache for Mosaic's Deno toolchain")

function(mosaic_provision_deno output)
    cmake_host_system_information(RESULT host_arch QUERY OS_PLATFORM)
    if(host_arch MATCHES "^(arm64|aarch64|ARM64)$")
        set(arch aarch64)
    elseif(host_arch MATCHES "^(x86_64|AMD64|amd64)$")
        set(arch x86_64)
    else()
        message(FATAL_ERROR "Unsupported Deno host architecture: ${host_arch}")
    endif()

    if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
        set(host "${arch}-apple-darwin")
    elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
        set(host "${arch}-unknown-linux-gnu")
    elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Windows")
        set(host "${arch}-pc-windows-msvc")
    else()
        message(FATAL_ERROR "Unsupported Deno host system: ${CMAKE_HOST_SYSTEM_NAME}")
    endif()

    if(host STREQUAL "aarch64-apple-darwin")
        set(hash 9f0bf660393da2eaff044cdc7444cb08c73f235849b61d224d825a194ce7c98e)
    elseif(host STREQUAL "x86_64-apple-darwin")
        set(hash 4b2f5edd2639b7470f034238b321d7002d8dfb4726d8558f52c17afac370eb2c)
    elseif(host STREQUAL "aarch64-unknown-linux-gnu")
        set(hash d49596c20b9788cf8f5d8ddf644103d4bde56ed239753f0bdb92ba9361d51905)
    elseif(host STREQUAL "x86_64-unknown-linux-gnu")
        set(hash e890975bc2549807bbcc0b584ffafda72cc7c93349dd99c80483dd784f6c4609)
    elseif(host STREQUAL "aarch64-pc-windows-msvc")
        set(hash b413b92b735b50c198e8fe3b85af1aa50e29d5f72e229aab701d132286e14cef)
    elseif(host STREQUAL "x86_64-pc-windows-msvc")
        set(hash cba84b26e0df5ae7f74fc66b86a95b866872a86292ebd84fa1e959927edd93bf)
    endif()

    set(version v2.9.8)
    set(name "deno-${host}.zip")
    set(url "https://github.com/denoland/deno/releases/download/${version}/${name}")
    set(archive "${MOSAIC_DENO_CACHE}/archives/${version}-${name}")
    set(install "${MOSAIC_DENO_CACHE}/${version}-${host}")
    if(CMAKE_HOST_WIN32)
        set(exe_suffix .exe)
        set(exe "${install}/deno.exe")
    else()
        set(exe_suffix "")
        set(exe "${install}/deno")
    endif()

    file(MAKE_DIRECTORY "${MOSAIC_DENO_CACHE}/archives")
    file(LOCK "${MOSAIC_DENO_CACHE}/setup.lock" GUARD FUNCTION TIMEOUT 600)

    if(NOT EXISTS "${exe}")
        if(NOT EXISTS "${archive}")
            message(STATUS "Downloading Deno ${version} for ${host}")
            file(DOWNLOAD "${url}" "${archive}.part" EXPECTED_HASH "SHA256=${hash}"
                TLS_VERIFY ON STATUS status SHOW_PROGRESS)
            list(GET status 0 code)
            if(NOT code EQUAL 0)
                file(REMOVE "${archive}.part")
                message(FATAL_ERROR "Deno download failed: ${status}")
            endif()
            file(RENAME "${archive}.part" "${archive}")
        endif()

        file(SHA256 "${archive}" actual_hash)
        if(NOT actual_hash STREQUAL hash)
            message(FATAL_ERROR "Deno archive checksum mismatch: ${archive}")
        endif()

        file(REMOVE_RECURSE "${install}.partial")
        file(MAKE_DIRECTORY "${install}.partial")
        file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${install}.partial")
        if(NOT EXISTS "${install}.partial/deno${exe_suffix}")
            message(FATAL_ERROR "Unexpected Deno archive layout: ${archive}")
        endif()
        file(REMOVE_RECURSE "${install}")
        file(RENAME "${install}.partial" "${install}")
    endif()

    if(NOT CMAKE_HOST_WIN32)
        file(CHMOD "${exe}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE
            GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
    endif()
    set(${output} "${exe}" PARENT_SCOPE)
endfunction()
